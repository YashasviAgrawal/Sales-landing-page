# -----------------------------------------------------------------------------
#  Copy this file to .env.local and fill it in. Restart the dev server after.
#
#    cp .env.example .env.local        (PowerShell: copy .env.example .env.local)
#
#  .env.local is gitignored. This file is committed and must never contain a
#  real key - it is the template, not the secret.
#
#  Full walkthrough, including creating the admin user: SUPABASE.md
# -----------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL
#
# The BARE project URL, with no path and no trailing slash. The dashboard also
# shows an endpoint ending in /rest/v1/ - that is not this. supabase-js appends
# /rest/v1 itself, so pasting the longer one produces "Invalid path specified in
# request URL" on every query, which does not obviously point back to here.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase -> Project Settings -> API Keys -> anon / public
#
# Safe to ship to the browser - that is what NEXT_PUBLIC_ means, and it is why
# the leads table has RLS on with no policies (see supabase/schema.sql). This
# key can read nothing there. It is used only for the admin sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase -> Project Settings -> API Keys -> service_role  (click "Reveal")
#
# SERVER ONLY. This key bypasses Row Level Security entirely: anyone holding it
# can read, edit and delete every row in the database. Never add NEXT_PUBLIC_
# to it, never import it into a "use client" file, never paste it into an issue
# or a chat. If it leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection, used ONLY by `npm run db:migrate`.
#
# Migrations create and alter tables, and the service role key above talks to
# the REST API, which cannot do that - so this is a second, separate credential.
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler,
# with [YOUR-PASSWORD] replaced by the database password.
#
# SERVER ONLY, and not needed at runtime at all: the app never opens a Postgres
# socket. It is safe to leave this out of the production environment entirely
# and run migrations from a laptop or CI.
SUPABASE_DB_URL=""

# Who may open /admin. Comma-separated, case-insensitive.
#
# A Supabase account is not enough on its own - the email must also appear
# here. An empty or missing value locks everyone out, which is the safe way for
# this to fail. Each address needs a real user created in
# Supabase -> Authentication -> Users.
ADMIN_EMAILS="example@youremail.com"

# The canonical origin of the live site, with no trailing slash.
#
# Needed because canonical tags, sitemap entries, RSS links and OpenGraph URLs
# must be absolute, and a server has no reliable way to know its own public
# address - behind a proxy the Host header is whatever the proxy says.
#
# Leave it unset in development. On Vercel it falls back to VERCEL_PROJECT_
# PRODUCTION_URL, but set it explicitly for a custom domain, or every canonical
# tag will point at the .vercel.app address and the real domain will be treated
# as the duplicate.
NEXT_PUBLIC_SITE_URL=""

# Optional. Salt for the one-way hash of submitter IP addresses, which is what
# lets duplicate and abuse detection work without the site storing anyone's
# address. Any long random string; `openssl rand -hex 32` produces a good one.
# Left unset, it falls back to the service role key, which is already secret.
# Changing it means old and new hashes no longer match.
LEAD_IP_SALT=""
